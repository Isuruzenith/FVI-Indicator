//@version=5
indicator("HTF Levels | Liq Sweep | FVG | Vol Delta", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=200)

// ══════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════
grp_daily     = "Daily HML Levels (4H / 2H / 1H / 30M)"
show_daily    = input.bool(true,  "Show Daily HML",  group=grp_daily)
daily_hi_col  = input.color(color.new(color.green,  30), "High Line",  group=grp_daily)
daily_mid_col = input.color(color.new(color.yellow, 30), "Mid Line",   group=grp_daily)
daily_lo_col  = input.color(color.new(color.red,    30), "Low Line",   group=grp_daily)
daily_width   = input.int(1, "Line Width", minval=1, maxval=3, group=grp_daily)

grp_30m       = "30M HML Levels (15M / 5M / 3M / 1M)"
show_30m      = input.bool(true,  "Show 30M HML",   group=grp_30m)
m30_hi_col    = input.color(color.new(color.green,  30), "High Line",  group=grp_30m)
m30_mid_col   = input.color(color.new(color.yellow, 30), "Mid Line",   group=grp_30m)
m30_lo_col    = input.color(color.new(color.red,    30), "Low Line",   group=grp_30m)
m30_width     = input.int(1, "Line Width", minval=1, maxval=3, group=grp_30m)

grp_liq       = "Liquidity Sweep Detection"
show_liq      = input.bool(true, "Highlight Sweep Candles (Blue)", group=grp_liq)
liq_lookback  = input.int(20, "Swing Lookback", minval=5, maxval=50, group=grp_liq)

grp_fvg       = "Fair Value Gap - 5M Only"
show_fvg      = input.bool(true, "Show FVG Boxes", group=grp_fvg)
fvg_bull_col  = input.color(color.new(color.teal,   75), "Bullish FVG", group=grp_fvg)
fvg_bear_col  = input.color(color.new(color.orange, 75), "Bearish FVG", group=grp_fvg)
fvg_max       = input.int(10, "Max FVG Boxes", minval=1, maxval=50, group=grp_fvg)

grp_vol       = "High Volume + Vol Delta - 5M Only"
show_vol      = input.bool(true, "Highlight High-Vol Candles", group=grp_vol)
vol_mult      = input.float(1.5, "Vol Multiplier (x avg)", minval=1.0, step=0.1, group=grp_vol)
vol_lookback  = input.int(20, "Volume Avg Lookback", minval=5, group=grp_vol)
vol_bull_col  = input.color(color.new(color.lime,   60), "High Vol Bull Candle", group=grp_vol)
vol_bear_col  = input.color(color.new(color.maroon, 60), "High Vol Bear Candle", group=grp_vol)

// ══════════════════════════════════════════════════════
//  TIMEFRAME — use timeframe.period string comparison
// ══════════════════════════════════════════════════════
// Detect current chart timeframe in minutes via simple checks
var float tfm = timeframe.isminutes ? timeframe.multiplier : timeframe.isseconds ? timeframe.multiplier / 60.0 : timeframe.ishours ? timeframe.multiplier * 60.0 : timeframe.isdaily ? 1440.0 : timeframe.isweekly ? 10080.0 : 43200.0

is_daily_range = tfm >= 1  and tfm <= 240
is_30m_range   = tfm >= 1  and tfm <= 15
is_5m          = timeframe.period == "5"

// ══════════════════════════════════════════════════════
//  HTF DATA
// ══════════════════════════════════════════════════════
d_high   = request.security("", "D",  high[1], lookahead=barmerge.lookahead_on)
d_low    = request.security("", "D",  low[1],  lookahead=barmerge.lookahead_on)
d_mid    = (d_high + d_low) / 2

m30_high = request.security("", "30", high[1], lookahead=barmerge.lookahead_on)
m30_low  = request.security("", "30", low[1],  lookahead=barmerge.lookahead_on)
m30_mid  = (m30_high + m30_low) / 2

// ══════════════════════════════════════════════════════
//  DRAW LINES — delete and recreate each bar (avoids set_price)
// ══════════════════════════════════════════════════════
var line ln_d_hi   = na
var line ln_d_mid  = na
var line ln_d_lo   = na
var line ln_30_hi  = na
var line ln_30_mid = na
var line ln_30_lo  = na

if show_daily and is_daily_range
    line.delete(ln_d_hi)
    line.delete(ln_d_mid)
    line.delete(ln_d_lo)
    ln_d_hi   := line.new(bar_index, d_high, bar_index + 500, d_high, xloc=xloc.bar_index, color=daily_hi_col,  width=daily_width, extend=extend.right)
    ln_d_mid  := line.new(bar_index, d_mid,  bar_index + 500, d_mid,  xloc=xloc.bar_index, color=daily_mid_col, width=daily_width, extend=extend.right)
    ln_d_lo   := line.new(bar_index, d_low,  bar_index + 500, d_low,  xloc=xloc.bar_index, color=daily_lo_col,  width=daily_width, extend=extend.right)

if show_30m and is_30m_range
    line.delete(ln_30_hi)
    line.delete(ln_30_mid)
    line.delete(ln_30_lo)
    ln_30_hi  := line.new(bar_index, m30_high, bar_index + 500, m30_high, xloc=xloc.bar_index, color=m30_hi_col,  width=m30_width, extend=extend.right)
    ln_30_mid := line.new(bar_index, m30_mid,  bar_index + 500, m30_mid,  xloc=xloc.bar_index, color=m30_mid_col, width=m30_width, extend=extend.right)
    ln_30_lo  := line.new(bar_index, m30_low,  bar_index + 500, m30_low,  xloc=xloc.bar_index, color=m30_lo_col,  width=m30_width, extend=extend.right)

// ══════════════════════════════════════════════════════
//  LIQUIDITY SWEEP
// ══════════════════════════════════════════════════════
swing_high    = ta.highest(high, liq_lookback)[1]
swing_low     = ta.lowest(low,  liq_lookback)[1]
bull_sweep    = show_liq and low  < swing_low  and close > swing_low
bear_sweep    = show_liq and high > swing_high and close < swing_high
is_sweep      = bull_sweep or bear_sweep

// ══════════════════════════════════════════════════════
//  HIGH VOLUME + DELTA (5M only)
// ══════════════════════════════════════════════════════
vol_avg       = ta.sma(volume, vol_lookback)
is_hi_vol     = is_5m and show_vol and volume > vol_avg * vol_mult
hl_range      = high - low
buy_vol       = hl_range > 0 ? volume * (close - low) / hl_range : volume * 0.5
sell_vol      = hl_range > 0 ? volume * (high - close) / hl_range : volume * 0.5
is_bull_delta = (buy_vol - sell_vol) >= 0

// ══════════════════════════════════════════════════════
//  BARCOLOR (single line — no multiline ternary)
// ══════════════════════════════════════════════════════
barcolor(is_sweep ? color.new(color.blue, 0) : is_hi_vol and is_bull_delta ? vol_bull_col : is_hi_vol and not is_bull_delta ? vol_bear_col : na)

// ══════════════════════════════════════════════════════
//  FVG BOXES (5M only)
// ══════════════════════════════════════════════════════
var box[] fvg_boxes = array.new_box()

if is_5m and show_fvg and barstate.isconfirmed
    if high[2] < low[0]
        array.push(fvg_boxes, box.new(bar_index - 2, low[0], bar_index, high[2], bgcolor=fvg_bull_col, border_color=color.new(color.teal, 50), extend=extend.right))
    if low[2] > high[0]
        array.push(fvg_boxes, box.new(bar_index - 2, low[2], bar_index, high[0], bgcolor=fvg_bear_col, border_color=color.new(color.orange, 50), extend=extend.right))
    if array.size(fvg_boxes) > fvg_max
        box.delete(array.shift(fvg_boxes))
    int i = array.size(fvg_boxes) - 1
    while i >= 0
        bx = array.get(fvg_boxes, i)
        if close > box.get_top(bx) or close < box.get_bottom(bx)
            box.delete(bx)
            array.remove(fvg_boxes, i)
        i := i - 1

// ══════════════════════════════════════════════════════
//  INVISIBLE PLOTS
// ══════════════════════════════════════════════════════
plot(show_daily and is_daily_range ? d_high   : na, "D High",   display=display.none)
plot(show_daily and is_daily_range ? d_mid    : na, "D Mid",    display=display.none)
plot(show_daily and is_daily_range ? d_low    : na, "D Low",    display=display.none)
plot(show_30m   and is_30m_range   ? m30_high : na, "30M High", display=display.none)
plot(show_30m   and is_30m_range   ? m30_mid  : na, "30M Mid",  display=display.none)
plot(show_30m   and is_30m_range   ? m30_low  : na, "30M Low",  display=display.none)
