// ============================================================
//  LIQUIDITY SWEEP & ORDER FLOW TRACKER
//  Pine Script v5  |  Version 1.1.0  (syntax-fixed)
//
//  Features:
//    - HTF Liquidity Levels  (PDH/PDL, PWH/PWL, PMH/PML)
//    - Wick-rejection Sweep Detection with configurable threshold
//    - Change of Character (ChoCh) & Break of Structure (BOS)
//    - Fair Value Gap (FVG) detection & mitigation tracking
//    - Real-time alerts for all three signal types
// ============================================================

//@version=5
indicator(title = "Liquidity Sweep & Order Flow Tracker", shorttitle = "LS-OFT", overlay = true, max_lines_count = 200, max_labels_count = 200, max_boxes_count = 200)

// ──────────────────────────────────────────────
//  INPUTS
// ──────────────────────────────────────────────

// Liquidity Levels
i_liqTF         = input.timeframe("D",   "Liquidity Timeframe",    group = "Liquidity Levels", tooltip = "D=Daily  W=Weekly  M=Monthly")
i_showLiqLines  = input.bool(true,       "Show Liquidity Lines",    group = "Liquidity Levels")
i_showLiqLabels = input.bool(true,       "Show Liquidity Labels",   group = "Liquidity Levels")
i_liqColor      = input.color(color.new(color.yellow, 0), "Line Color", group = "Liquidity Levels")

// Sweep Detection
i_wickThresh  = input.float(0.3,  "Sweep Wick Threshold (%)", minval = 0.0, maxval = 5.0, step = 0.05, group = "Sweep Detection", tooltip = "Min wick/range ratio to validate a sweep. Raise to filter noise.")
i_showSweep   = input.bool(true,  "Show Sweep Labels",        group = "Sweep Detection")
i_sweepBullC  = input.color(color.new(color.aqua,   0), "Bullish Sweep Color", group = "Sweep Detection")
i_sweepBearC  = input.color(color.new(color.orange, 0), "Bearish Sweep Color", group = "Sweep Detection")

// Order Flow / Structure
i_swingLen   = input.int(5,    "Swing Lookback",  minval = 2, maxval = 20, group = "Order Flow / Structure", tooltip = "Bars each side for pivot detection")
i_showChoch  = input.bool(true, "Show ChoCh Lines", group = "Order Flow / Structure")
i_showBos    = input.bool(true, "Show BOS Lines",   group = "Order Flow / Structure")
i_chochColor = input.color(color.new(color.fuchsia, 0), "ChoCh Color", group = "Order Flow / Structure")
i_bosColor   = input.color(color.new(color.lime,    0), "BOS Color",   group = "Order Flow / Structure")

// Fair Value Gaps
i_showFVG    = input.bool(true,  "Show FVG Boxes",           group = "Fair Value Gaps")
i_fvgExtend  = input.int(50,     "Extend FVG Boxes (bars)",  group = "Fair Value Gaps", minval = 1, maxval = 500)
i_fvgBullC   = input.color(color.new(color.green, 80), "Bullish FVG Fill",  group = "Fair Value Gaps")
i_fvgBearC   = input.color(color.new(color.red,   80), "Bearish FVG Fill",  group = "Fair Value Gaps")
i_fvgBorderC = input.color(color.new(color.gray,  50), "FVG Border Color",  group = "Fair Value Gaps")

// ──────────────────────────────────────────────
//  HTF LIQUIDITY LEVELS
// ──────────────────────────────────────────────

// lookahead_on + [1] index: fetches previous confirmed HTF bar — no repainting
htfHigh = request.security(syminfo.tickerid, i_liqTF, high[1], lookahead = barmerge.lookahead_on)
htfLow  = request.security(syminfo.tickerid, i_liqTF, low[1],  lookahead = barmerge.lookahead_on)

// Label prefix based on chosen timeframe
string liqPrefix = i_liqTF == "D" ? "PD" : i_liqTF == "W" ? "PW" : i_liqTF == "M" ? "PM" : "P"

// Persistent line & label handles
var line  liqHighLine = na
var line  liqLowLine  = na
var label liqHighLbl  = na
var label liqLowLbl   = na

// Redraw every bar so lines stay at current price (extend.right keeps them visible)
if i_showLiqLines
    line.delete(liqHighLine)
    line.delete(liqLowLine)
    liqHighLine := line.new(bar_index, htfHigh, bar_index + 1, htfHigh, extend = extend.right, color = i_liqColor, style = line.style_dotted, width = 1)
    liqLowLine  := line.new(bar_index, htfLow,  bar_index + 1, htfLow,  extend = extend.right, color = i_liqColor, style = line.style_dotted, width = 1)

if i_showLiqLabels
    label.delete(liqHighLbl)
    label.delete(liqLowLbl)
    liqHighLbl := label.new(bar_index + 2, htfHigh, text = liqPrefix + "H", style = label.style_none, color = color.new(color.white, 100), textcolor = i_liqColor, size = size.small)
    liqLowLbl  := label.new(bar_index + 2, htfLow,  text = liqPrefix + "L", style = label.style_none, color = color.new(color.white, 100), textcolor = i_liqColor, size = size.small)

// ──────────────────────────────────────────────
//  SWEEP DETECTION
//  1. Wick pierces the liquidity level
//  2. Candle BODY closes back inside (wick rejection)
//  3. Wick size >= threshold % of total range
// ──────────────────────────────────────────────

float candleRange  = high - low
float bodyHigh     = math.max(open, close)
float bodyLow      = math.min(open, close)
float upperWick    = high - bodyHigh
float lowerWick    = bodyLow - low
float wickThreshFr = i_wickThresh / 100.0

// Bullish sweep: wick below PDL, body closes above PDL
bool bullSweep = (low < htfLow) and (close > htfLow) and (candleRange > 0) and ((lowerWick / candleRange) >= wickThreshFr)

// Bearish sweep: wick above PDH, body closes below PDH
bool bearSweep = (high > htfHigh) and (close < htfHigh) and (candleRange > 0) and ((upperWick / candleRange) >= wickThreshFr)

if i_showSweep
    if bullSweep
        label.new(bar_index, low,  text = "Sweep", style = label.style_label_up,   color = i_sweepBullC, textcolor = color.black, size = size.small)
    if bearSweep
        label.new(bar_index, high, text = "Sweep", style = label.style_label_down, color = i_sweepBearC, textcolor = color.black, size = size.small)

// ──────────────────────────────────────────────
//  SWING HIGH / LOW (for ChoCh / BOS)
// ──────────────────────────────────────────────

float swingHigh = ta.pivothigh(high, i_swingLen, i_swingLen)
float swingLow  = ta.pivotlow (low,  i_swingLen, i_swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastSHBar     = na
var int   lastSLBar     = na

if not na(swingHigh)
    lastSwingHigh := swingHigh
    lastSHBar     := bar_index - i_swingLen

if not na(swingLow)
    lastSwingLow  := swingLow
    lastSLBar     := bar_index - i_swingLen

// ──────────────────────────────────────────────
//  CHANGE OF CHARACTER (ChoCh) & BREAK OF STRUCTURE (BOS)
//
//  ChoCh: first structural break AFTER a sweep  -> reversal signal
//  BOS:   structural break with no prior sweep  -> continuation signal
//
//  Both require a candle BODY close (not wick) past the swing level.
// ──────────────────────────────────────────────

var bool sweepArmed = false
var bool sweepIsBull = false

if bullSweep
    sweepArmed  := true
    sweepIsBull := true
if bearSweep
    sweepArmed  := true
    sweepIsBull := false

// ChoCh conditions (sweep must be armed first)
bool chochBull = sweepArmed and sweepIsBull  and not na(lastSwingHigh) and (close > lastSwingHigh)
bool chochBear = sweepArmed and not sweepIsBull and not na(lastSwingLow)  and (close < lastSwingLow)

// BOS conditions (no armed sweep)
bool bosBull = not sweepArmed and not na(lastSwingHigh) and (close > lastSwingHigh)
bool bosBear = not sweepArmed and not na(lastSwingLow)  and (close < lastSwingLow)

// Reset sweep flag after ChoCh fires
if chochBull or chochBear
    sweepArmed := false

if i_showChoch
    if chochBull
        line.new(lastSHBar, lastSwingHigh, bar_index, lastSwingHigh, color = i_chochColor, style = line.style_solid, width = 2)
        label.new(bar_index, lastSwingHigh, text = "ChoCh", style = label.style_label_down, color = i_chochColor, textcolor = color.black, size = size.small)
    if chochBear
        line.new(lastSLBar, lastSwingLow, bar_index, lastSwingLow, color = i_chochColor, style = line.style_solid, width = 2)
        label.new(bar_index, lastSwingLow, text = "ChoCh", style = label.style_label_up, color = i_chochColor, textcolor = color.black, size = size.small)

if i_showBos
    if bosBull
        line.new(lastSHBar, lastSwingHigh, bar_index, lastSwingHigh, color = i_bosColor, style = line.style_solid, width = 1)
        label.new(bar_index, lastSwingHigh, text = "BOS", style = label.style_label_down, color = i_bosColor, textcolor = color.black, size = size.tiny)
    if bosBear
        line.new(lastSLBar, lastSwingLow, bar_index, lastSwingLow, color = i_bosColor, style = line.style_solid, width = 1)
        label.new(bar_index, lastSwingLow, text = "BOS", style = label.style_label_up, color = i_bosColor, textcolor = color.black, size = size.tiny)

// ──────────────────────────────────────────────
//  FAIR VALUE GAP (FVG)
//
//  3-candle imbalance pattern, only detected after a ChoCh:
//    Bullish FVG : high[2] < low[0]  (gap up — candle-3 top below candle-1 bottom)
//    Bearish FVG : low[2]  > high[0] (gap down — candle-3 bottom above candle-1 top)
//
//  Box right edge extends until price mitigates (re-enters) the zone.
// ──────────────────────────────────────────────

var int chochBar = na
if chochBull or chochBear
    chochBar := bar_index

int  fvgWindow = 20
bool fvgActive = not na(chochBar) and (bar_index - chochBar <= fvgWindow)

bool bullFVG = fvgActive and (high[2] < low[0])
bool bearFVG = fvgActive and (low[2]  > high[0])

// Arrays to track unmitigated FVG boxes
var box[]   fvgBoxes  = array.new_box()
var float[] fvgTopArr = array.new_float()
var float[] fvgBotArr = array.new_float()

if i_showFVG
    if bullFVG
        float fTop = low[0]
        float fBot = high[2]
        array.push(fvgBoxes,  box.new(bar_index - 2, fTop, bar_index + i_fvgExtend, fBot, border_color = i_fvgBorderC, bgcolor = i_fvgBullC))
        array.push(fvgTopArr, fTop)
        array.push(fvgBotArr, fBot)

    if bearFVG
        float fTop = low[2]
        float fBot = high[0]
        array.push(fvgBoxes,  box.new(bar_index - 2, fTop, bar_index + i_fvgExtend, fBot, border_color = i_fvgBorderC, bgcolor = i_fvgBearC))
        array.push(fvgTopArr, fTop)
        array.push(fvgBotArr, fBot)

// Mitigation check & box extension
var bool fvgTapped = false
fvgTapped := false

if array.size(fvgBoxes) > 0
    int i = array.size(fvgBoxes) - 1
    while i >= 0
        float fTop = array.get(fvgTopArr, i)
        float fBot = array.get(fvgBotArr, i)
        box   b    = array.get(fvgBoxes,  i)
        bool  hit  = (close <= fTop and close >= fBot) or (low <= fTop and low >= fBot) or (high <= fTop and high >= fBot)
        if hit
            box.set_right(b, bar_index)
            array.remove(fvgBoxes,  i)
            array.remove(fvgTopArr, i)
            array.remove(fvgBotArr, i)
            fvgTapped := true
        else
            box.set_right(b, bar_index + i_fvgExtend)
        i := i - 1

// ──────────────────────────────────────────────
//  ALERT CONDITIONS
// ──────────────────────────────────────────────

alertcondition(bullSweep, title = "Liquidity Swept (Bullish)", message = "Bullish Sweep — wick rejected below HTF low. Watch for ChoCh.")
alertcondition(bearSweep, title = "Liquidity Swept (Bearish)", message = "Bearish Sweep — wick rejected above HTF high. Watch for ChoCh.")
alertcondition(chochBull or chochBear, title = "Order Flow Shift (ChoCh)", message = "ChoCh confirmed — potential trend reversal. Check for FVG entry.")
alertcondition(fvgTapped, title = "Entry Zone Tap (FVG)", message = "Price entered an unmitigated FVG — potential trade entry zone.")
alertcondition(bullSweep or bearSweep or chochBull or chochBear or fvgTapped, title = "LS-OFT Any Signal", message = "LS-OFT signal fired. Check chart for Sweep / ChoCh / FVG.")
